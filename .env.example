# ============================================================
# AIOS environment configuration (example)
# Copy to .env and fill in real values. Never commit .env itself.
# ============================================================

# ------------------------------------------------------------
# Kernel / Dispatcher
# ------------------------------------------------------------

# Redis connection string used by aios.kernel.queue_backend.RedisQueueBackend
# when a Redis-backed syscall queue is constructed explicitly.
# Not required for the default in-memory queue backend.
REDIS_URL=redis://localhost:6379/0

# Number of dispatcher worker threads (bounds syscall concurrency).
AIOS_DISPATCHER_WORKER_COUNT=4

# ------------------------------------------------------------
# LLM Providers (OpenAI, Groq, Ollama)
# ------------------------------------------------------------

# OpenAI API credentials and optional endpoints
OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORG_ID=your-openai-org-id

# Groq Cloud API credentials and optional endpoints
GROQ_API_KEY=your-groq-api-key-here
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama local/remote server endpoint (no API key required)
OLLAMA_BASE_URL=http://localhost:11434

